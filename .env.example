# ========================================================
# VARIÁVEIS DE AMBIENTE - RECEPCIONISTA PRO & STUDIO
# ========================================================

# 1. Inteligência Artificial Google Gemini (Google AI Studio / AI Pro)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Banco de Dados Supabase (PostgreSQL para Produção na Vercel)
# Obtenha em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# 3. Mercado Pago (Opcional - caso queira receber PIX automático)
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
